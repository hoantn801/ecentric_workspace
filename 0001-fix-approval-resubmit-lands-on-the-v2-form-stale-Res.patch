@@ -4042,6 +4042,21 @@ html body .ec-main .content { padding: 28px 32px 40px !important; max-width: 140
     var submitter = (docData.submitted_by || '').toLowerCase();
     var currentUser = (getSessionEmail() || '').toLowerCase();
     var isSubmitter = (currentUser === submitter);
+    var docOwner = (docData.owner || docData.created_by || '').toLowerCase();
+    if (!isSubmitter && currentUser && currentUser === docOwner) { isSubmitter = true; }
+    if (!isSubmitter) { /* ec-resubmit-realuser-v1: getSessionEmail rong tren portal -> fetch user that, reveal nut cho submitter/owner (backend van gac quyen) */
+      window._ecCurUserPromise = window._ecCurUserPromise || fetch('/api/method/frappe.auth.get_logged_user', {credentials:'include'}).then(function(r){ return r.json(); }).then(function(d){ return (((d && d.message) || '') + '').toLowerCase(); }).catch(function(){ return ''; });
+      window._ecCurUserPromise.then(function(realU){
+        if (!(realU && (realU === submitter || realU === docOwner))) return;
+        if (document.getElementById('ec-csb-resubmit-btn')) return;
+        var note = document.getElementById('ec-csb-nonsubmitter-note');
