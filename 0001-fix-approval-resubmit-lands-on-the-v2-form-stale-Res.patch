     var sentBy = '—', sentAt = '—';
     try {
@@ -4588,6 +4603,7 @@ function ecDriftBadge(doc){
       var gg = parseFloat(doc.gbs_grand_total || 0);
       /* ec-drift-v3 gate removed - item-level only */
       if (!doc.gbs_doc_name) return; /* ec-drift-v2 item-level */
+      var ecLst = ((doc.status||'')+'').toLowerCase(); var ecGst = ((doc.gbs_status||'')+'').toLowerCase(); if (ecLst !== 'approved' || !(ecGst === 'approved' || ecGst === 'completed')) return; /* ec-drift-settled-guard-v1 */
       var ecGJ = {}; try { ecGJ = JSON.parse(doc.gbs_response_json || '{}'); } catch(e) { return; }
       var ecGItems = ecGJ.items || []; var ecLItems = doc.items || [];
       if (!ecGItems.length && !ecLItems.length) return;
@@ -6001,6 +6017,8 @@ console.log('[ec-gbs-timeline] script tag fully parsed');
       var existing = document.getElementById('ec-gbs-resubmit-btn');
       if (existing && !shouldShow) {
         existing.remove();
+        /* ec-resubmit-repoll-v1: un-hide the Submit-on-GBS button this block hid */
+        var _sbRestore = findSubmitBtn(); if (_sbRestore) _sbRestore.style.display = '';
       }
 
       if (!shouldShow) {
@@ -6009,7 +6027,11 @@ console.log('[ec-gbs-timeline] script tag fully parsed');
         return;
       }
 
-      if (existing) return;
+      /* ec-resubmit-repoll-v1: previously `return` with no re-poll, so once the button
+         was inserted ensureButton() never ran again — after the user resubmitted and
+         status flipped to 'Cần sửa' the stale Resubmit button stayed on screen next to
+         the banner's "Sửa & Submit lại". Keep the 3s poll alive so it gets removed. */
+      if (existing) { setTimeout(ensureButton, 3000); return; }
 
       // Find anchor: Submit on GBS button OR Check Status button - inject Resubmit nearby
       var submitBtn = findSubmitBtn();
