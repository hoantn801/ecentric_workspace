+        var b = document.createElement('button');
+        b.className = 'csb-btn'; b.id = 'ec-csb-resubmit-btn'; b.textContent = 'S\u1eeda & Submit l\u1ea1i';
+        note.parentNode.insertBefore(b, note); note.style.display = 'none';
