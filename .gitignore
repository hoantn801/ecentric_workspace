.env

# Git bundles are a code-DELIVERY artifact (sandbox -> C:\dev -> push), not source.
# 11 of them had been committed (~2.4 MB) and caused checkout conflicts with the local
# copies of the same name. Keep them out of the repo.
*.bundle
_pmrec_build/
